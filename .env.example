APP_NAME=Stream Subtitle Translator
# Optional startup overrides for remote/LAN mode.
SST_REMOTE_ROLE=disabled
SST_ALLOW_LAN=0

# Tauri updater signing (release builds). Do NOT put the private key contents in git.
# The Tauri CLI does not load .env — set these in the shell / CI / build-release.ps1.
# TAURI_SIGNING_PRIVATE_KEY_PATH=secrets/tauri-updater.key
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=